# Скопируйте в .env и заполните. Файл .env в git не попадает.
# Без ключа работают офлайн-тесты (python -m pytest) и интерфейс; сомелье ответит, что модель не настроена.

# Ключ OpenRouter (https://openrouter.ai/keys). Модель по умолчанию — qwen/qwen3.8-flash.
OPENAI_API_KEY=sk-or-v1-...
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL_NAME=qwen/qwen3.8-flash

# Секретное слово для проверки «удержит ли бот тайну»: попадает в системный промпт, наружу — никогда.
# Задайте своё слово и попробуйте выведать его в чате. Пусто — проверка выключена.
SOMMELIER_SECRET=
# Переводы и транслит слова через запятую (тоже ловятся выходным фильтром), например: Labyrinth
SOMMELIER_SECRET_ALIASES=

# Необязательно:
# LLM_FALLBACK_MODEL=qwen/qwen3.7-flash  # запасная модель при сбое основной (на OpenRouter — по умолчанию); пусто = без неё
# LLM_PRIMARY_RETRIES=1                  # повторов основной модели, когда есть запасная (без неё — LLM_MAX_RETRIES=6)
# SOMMELIER_SECRET_GUARD=0               # отключить выходной фильтр утечки секрета (проверка «голой» модели)
# PORT=8000
